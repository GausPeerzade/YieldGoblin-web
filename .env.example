# ── Wallet connection ───────────────────────────────────────────────────────
# Required for WalletConnect / mobile wallets. Get one at https://cloud.reown.com
# Injected wallets (MetaMask, Rabby…) work without it; the console will warn.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── RPC ─────────────────────────────────────────────────────────────────────
# Contract calls. STRONGLY recommended — the public Base endpoint rate-limits
# hard, and per-request latency is what the vault page actually waits on.
# Falls back to the public endpoint automatically if unset or failing.
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Endpoint for eth_getLogs, which needs a WIDE block range rather than low
# latency. Alchemy's free tier caps getLogs at 10 blocks — hundreds of requests
# for one vault's history — while public Base allows 10,000 and does it in one.
# Leave blank to use the public endpoint; only set this on a paid plan.
NEXT_PUBLIC_BASE_LOGS_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_LOGS_RPC_URL=

# ── Protocol ────────────────────────────────────────────────────────────────
# The live Base mainnet factory is the built-in default; set this only to point
# at a redeploy. Leave blank otherwise — blank is treated as unset.
NEXT_PUBLIC_VAULT_FACTORY_BASE=
NEXT_PUBLIC_VAULT_FACTORY_BASE_SEPOLIA=

# ConditionalTokens on testnet only — the Base mainnet address is built in.
NEXT_PUBLIC_CTF_BASE_SEPOLIA=
